  "version": "0.2.0",
  "configurations": [
    {
      "name": "PMS.API (Debug dll)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/PMS.API/bin/Debug/net9.0/PMS.API.dll",
      "args": [],
      "cwd": "${workspaceFolder}/PMS.API",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "C#: <project-name> Debug",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/<relative-path-to-project-folder><project-name>.csproj"
    },

    {
      "name": "C#: PMS.API [https]",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/PMS.API/PMS.API.csproj",
      "launchConfigurationId": "TargetFramework=;https"
    }
  ]
}